    basket_1
  )

  (:init
    (On cupcake__objaverse_12_1 floor_target_object_region)
    (On sweet_potato__objaverse_3_1 floor_other_object_region_0)
    (On beer__aigen_1_1 floor_other_object_region_1)
    (On cup__aigen_17_1 floor_other_object_region_2)
    (On saucepan__objaverse_pan_17_1 floor_other_object_region_3)
    (On bottled_drink__aigen_4_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
