    (On syrup_bottle__aigen_9_1 floor_other_object_region_0)
    (On cucumber__aigen_7_1 floor_other_object_region_1)
    (On broccoli__objaverse_1_1 floor_other_object_region_2)
    (On asparagus__aigen_1_1 floor_other_object_region_3)
    (On kiwi__aigen_6_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
