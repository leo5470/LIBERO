    (On mango__aigen_2_1 floor_other_object_region_0)
    (On bowl__objaverse_19_1 floor_other_object_region_1)
    (On rolling_pin__aigen_5_1 floor_other_object_region_2)
    (On canola_oil__aigen_6_1 floor_other_object_region_3)
    (On onion__objaverse_10_1 floor_other_object_region_4)
