  (:fixtures
    floor - floor
  )

  (:objects
    cheese__aigen_4_1 - cheese__aigen_4
    mango__aigen_2_1 - mango__aigen_2
    bowl__objaverse_19_1 - bowl__objaverse_19
    rolling_pin__aigen_5_1 - rolling_pin__aigen_5
