(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the beer and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (liquid
          (:target jug_wide_opening__objaverse_jug_8_1)
      )
      (reg_int
          (:target jug_wide_opening__objaverse_jug_8_1)
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    beer__objaverse_12_1 - beer__objaverse_12
    bottled_drink__objaverse_4_1 - bottled_drink__objaverse_4
    jug_wide_opening__objaverse_jug_8_1 - jug_wide_opening__objaverse_jug_8
    steak__aigen_3_1 - steak__aigen_3
    cheese__objaverse_1_1 - cheese__objaverse_1
    peanut_butter__aigen_jar_12_1 - peanut_butter__aigen_jar_12
    basket_1 - basket
  )

  (:obj_of_interest
    beer__objaverse_12_1
    basket_1
  )

  (:init
    (On beer__objaverse_12_1 floor_target_object_region)
    (On bottled_drink__objaverse_4_1 floor_other_object_region_0)
    (On jug_wide_opening__objaverse_jug_8_1 floor_other_object_region_1)
    (On steak__aigen_3_1 floor_other_object_region_2)
    (On cheese__objaverse_1_1 floor_other_object_region_3)
    (On peanut_butter__aigen_jar_12_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In beer__objaverse_12_1 basket_1_contain_region))
  )

)
