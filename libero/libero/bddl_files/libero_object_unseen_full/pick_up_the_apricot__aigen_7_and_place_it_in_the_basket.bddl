(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the apricot and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    apricot__aigen_7_1 - apricot__aigen_7
    fish__aigen_0_1 - fish__aigen_0
    tongs__aigen_0_1 - tongs__aigen_0
    peanut_butter__aigen_jar_4_1 - peanut_butter__aigen_jar_4
    bar__objaverse_3_1 - bar__objaverse_3
    lemon__aigen_11_1 - lemon__aigen_11
    basket_1 - basket
  )

  (:obj_of_interest
    apricot__aigen_7_1
    basket_1
  )

  (:init
    (On apricot__aigen_7_1 floor_target_object_region)
    (On fish__aigen_0_1 floor_other_object_region_0)
    (On tongs__aigen_0_1 floor_other_object_region_1)
    (On peanut_butter__aigen_jar_4_1 floor_other_object_region_2)
    (On bar__objaverse_3_1 floor_other_object_region_3)
    (On lemon__aigen_11_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In apricot__aigen_7_1 basket_1_contain_region))
  )

)
