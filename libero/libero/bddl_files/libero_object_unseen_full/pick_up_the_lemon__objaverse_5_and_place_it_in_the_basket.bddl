    basket_1
  )

  (:init
    (On lemon__objaverse_5_1 floor_target_object_region)
    (On honey_bottle__aigen_15_1 floor_other_object_region_0)
    (On wine_glass__aigen_6_1 floor_other_object_region_1)
    (On bread_flat__aigen_bread_3_1 floor_other_object_region_2)
    (On canned_food__objaverse_0_1 floor_other_object_region_3)
    (On kettle_non_electric__objaverse_kettle_16_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
