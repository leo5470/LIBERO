    basket_1
  )

  (:init
    (On candy__aigen_7_1 floor_target_object_region)
    (On burrito__aigen_1_1 floor_other_object_region_0)
    (On jello_cup__aigen_2_1 floor_other_object_region_1)
    (On bottled_water__objaverse_16_1 floor_other_object_region_2)
    (On wine__objaverse_4_1 floor_other_object_region_3)
    (On cup__aigen_17_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
