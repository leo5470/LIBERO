    (On kettle_non_electric__aigen_kettle_5_1 floor_other_object_region_0)
    (On saucepan__objaverse_pan_22_1 floor_other_object_region_1)
    (On mushroom__aigen_6_1 floor_other_object_region_2)
    (On coffee_cup__aigen_4_1 floor_other_object_region_3)
    (On shrimp__aigen_6_1 floor_other_object_region_4)
