(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the hot dog and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    hot_dog__aigen_1_1 - hot_dog__aigen_1
    celery__aigen_8_1 - celery__aigen_8
    wine_glass__aigen_5_1 - wine_glass__aigen_5
    avocado__aigen_10_1 - avocado__aigen_10
    tomato__objaverse_7_1 - tomato__objaverse_7
    lemon__objaverse_10_1 - lemon__objaverse_10
    basket_1 - basket
  )

  (:obj_of_interest
    hot_dog__aigen_1_1
    basket_1
  )

  (:init
    (On hot_dog__aigen_1_1 floor_target_object_region)
    (On celery__aigen_8_1 floor_other_object_region_0)
    (On wine_glass__aigen_5_1 floor_other_object_region_1)
    (On avocado__aigen_10_1 floor_other_object_region_2)
    (On tomato__objaverse_7_1 floor_other_object_region_3)
    (On lemon__objaverse_10_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In hot_dog__aigen_1_1 basket_1_contain_region))
  )

)
