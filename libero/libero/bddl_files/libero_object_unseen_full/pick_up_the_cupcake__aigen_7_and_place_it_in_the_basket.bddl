    basket_1
  )

  (:init
    (On cupcake__aigen_7_1 floor_target_object_region)
    (On candle__objaverse_14_1 floor_other_object_region_0)
    (On boxed_food__aigen_2_1 floor_other_object_region_1)
    (On bread__objaverse_5_1 floor_other_object_region_2)
    (On chili_pepper__aigen_4_1 floor_other_object_region_3)
    (On bell_pepper__objaverse_2_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
