    (On apricot__aigen_0_1 floor_other_object_region_0)
    (On olive_oil_bottle__aigen_6_1 floor_other_object_region_1)
    (On lemonade__aigen_2_1 floor_other_object_region_2)
    (On mushroom__objaverse_14_1 floor_other_object_region_3)
    (On jug_wide_opening__objaverse_jug_8_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
