(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the carrot and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (liquid
          (:target jug_wide_opening__objaverse_jug_8_1)
      )
      (reg_int
          (:target jug_wide_opening__objaverse_jug_8_1)
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    carrot__aigen_2_1 - carrot__aigen_2
    apricot__aigen_0_1 - apricot__aigen_0
    olive_oil_bottle__aigen_6_1 - olive_oil_bottle__aigen_6
    lemonade__aigen_2_1 - lemonade__aigen_2
    mushroom__objaverse_14_1 - mushroom__objaverse_14
    jug_wide_opening__objaverse_jug_8_1 - jug_wide_opening__objaverse_jug_8
    basket_1 - basket
  )

  (:obj_of_interest
