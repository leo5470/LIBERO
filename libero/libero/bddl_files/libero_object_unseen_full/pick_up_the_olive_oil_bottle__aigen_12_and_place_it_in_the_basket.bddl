    basket_1
  )

  (:init
    (On olive_oil_bottle__aigen_12_1 floor_target_object_region)
    (On shrimp__aigen_4_1 floor_other_object_region_0)
    (On carrot__objaverse_0_1 floor_other_object_region_1)
    (On pizza_cutter__aigen_7_1 floor_other_object_region_2)
    (On soap_dispenser__aigen_6_1 floor_other_object_region_3)
    (On rolling_pin__aigen_4_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
