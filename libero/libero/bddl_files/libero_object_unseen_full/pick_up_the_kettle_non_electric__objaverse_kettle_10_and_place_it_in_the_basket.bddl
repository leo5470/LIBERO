(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the kettle non electric and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    kettle_non_electric__objaverse_kettle_10_1 - kettle_non_electric__objaverse_kettle_10
    saucepan__objaverse_pan_17_1 - saucepan__objaverse_pan_17
    beer__objaverse_2_1 - beer__objaverse_2
    bar__objaverse_8_1 - bar__objaverse_8
    cheese_grater__aigen_4_1 - cheese_grater__aigen_4
    broccoli__objaverse_1_1 - broccoli__objaverse_1
    basket_1 - basket
  )

  (:obj_of_interest
    kettle_non_electric__objaverse_kettle_10_1
    basket_1
  )

  (:init
    (On kettle_non_electric__objaverse_kettle_10_1 floor_target_object_region)
    (On saucepan__objaverse_pan_17_1 floor_other_object_region_0)
    (On beer__objaverse_2_1 floor_other_object_region_1)
    (On bar__objaverse_8_1 floor_other_object_region_2)
    (On cheese_grater__aigen_4_1 floor_other_object_region_3)
    (On broccoli__objaverse_1_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In kettle_non_electric__objaverse_kettle_10_1 basket_1_contain_region))
  )

)
