    (On canned_food__objaverse_3_1 floor_other_object_region_0)
    (On boxed_food__objaverse_0_1 floor_other_object_region_1)
    (On fish__aigen_7_1 floor_other_object_region_2)
    (On cherry__aigen_7_1 floor_other_object_region_3)
    (On ladle__objaverse_2_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
