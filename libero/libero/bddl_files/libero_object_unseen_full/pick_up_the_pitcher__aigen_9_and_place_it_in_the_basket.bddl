    (On peanut_butter__aigen_jar_4_1 floor_other_object_region_0)
    (On can__objaverse_18_1 floor_other_object_region_1)
    (On bottled_water__objaverse_10_1 floor_other_object_region_2)
    (On egg__aigen_3_1 floor_other_object_region_3)
    (On thermos__aigen_12_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
