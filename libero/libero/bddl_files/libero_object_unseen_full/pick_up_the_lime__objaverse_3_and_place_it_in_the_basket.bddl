    basket_1
  )

  (:init
    (On lime__objaverse_3_1 floor_target_object_region)
    (On peanut_butter__aigen_jar_12_1 floor_other_object_region_0)
    (On pot__aigen_0_1 floor_other_object_region_1)
    (On garlic__objaverse_5_1 floor_other_object_region_2)
    (On mango__aigen_0_1 floor_other_object_region_3)
    (On kettle_non_electric__aigen_kettle_4_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
