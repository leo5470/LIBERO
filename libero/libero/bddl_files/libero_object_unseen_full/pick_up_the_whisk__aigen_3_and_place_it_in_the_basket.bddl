    basket_1
  )

  (:init
    (On whisk__aigen_3_1 floor_target_object_region)
    (On candle__objaverse_6_1 floor_other_object_region_0)
    (On ginger__aigen_5_1 floor_other_object_region_1)
    (On thermos__aigen_10_1 floor_other_object_region_2)
    (On spray__objaverse_2_1 floor_other_object_region_3)
    (On tongs__aigen_6_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
