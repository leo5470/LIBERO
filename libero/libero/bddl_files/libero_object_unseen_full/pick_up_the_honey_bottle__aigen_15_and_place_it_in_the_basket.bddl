    (On tangerine__aigen_4_1 floor_other_object_region_0)
    (On bread_flat__aigen_bread_11_1 floor_other_object_region_1)
    (On cake__aigen_6_1 floor_other_object_region_2)
    (On ladle__aigen_6_1 floor_other_object_region_3)
    (On jam__aigen_15_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
