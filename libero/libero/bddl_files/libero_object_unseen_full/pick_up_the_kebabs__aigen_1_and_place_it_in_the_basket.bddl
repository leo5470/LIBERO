(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the kebabs and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    kebabs__aigen_1_1 - kebabs__aigen_1
    milk__objaverse_4_1 - milk__objaverse_4
    whisk__aigen_7_1 - whisk__aigen_7
    ginger__aigen_4_1 - ginger__aigen_4
    condiment_bottle__objaverse_condiment_0_1 - condiment_bottle__objaverse_condiment_0
    mug__objaverse_13_1 - mug__objaverse_13
    basket_1 - basket
  )

  (:obj_of_interest
    kebabs__aigen_1_1
    basket_1
  )

  (:init
    (On kebabs__aigen_1_1 floor_target_object_region)
    (On milk__objaverse_4_1 floor_other_object_region_0)
    (On whisk__aigen_7_1 floor_other_object_region_1)
    (On ginger__aigen_4_1 floor_other_object_region_2)
    (On condiment_bottle__objaverse_condiment_0_1 floor_other_object_region_3)
    (On mug__objaverse_13_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In kebabs__aigen_1_1 basket_1_contain_region))
  )

)
