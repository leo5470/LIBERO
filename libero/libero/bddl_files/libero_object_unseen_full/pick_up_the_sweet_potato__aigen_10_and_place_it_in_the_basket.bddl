    (On garlic__objaverse_0_1 floor_other_object_region_1)
    (On fish__objaverse_10_1 floor_other_object_region_2)
    (On bowl__objaverse_5_1 floor_other_object_region_3)
    (On bottled_water__objaverse_3_1 floor_other_object_region_4)
