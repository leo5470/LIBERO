(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the croissant and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    croissant__objaverse_8_1 - croissant__objaverse_8
    bar_soap__aigen_5_1 - bar_soap__aigen_5
    boxed_drink__objaverse_3_1 - boxed_drink__objaverse_3
    hot_dog__objaverse_1_1 - hot_dog__objaverse_1
    sponge__aigen_3_1 - sponge__aigen_3
    cupcake__objaverse_11_1 - cupcake__objaverse_11
    basket_1 - basket
  )

  (:obj_of_interest
    croissant__objaverse_8_1
    basket_1
  )

  (:init
    (On croissant__objaverse_8_1 floor_target_object_region)
    (On bar_soap__aigen_5_1 floor_other_object_region_0)
    (On boxed_drink__objaverse_3_1 floor_other_object_region_1)
    (On hot_dog__objaverse_1_1 floor_other_object_region_2)
    (On sponge__aigen_3_1 floor_other_object_region_3)
    (On cupcake__objaverse_11_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In croissant__objaverse_8_1 basket_1_contain_region))
  )

)
