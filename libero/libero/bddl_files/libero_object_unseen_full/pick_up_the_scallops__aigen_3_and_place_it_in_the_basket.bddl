    )

  (:fixtures
    floor - floor
  )

  (:objects
    scallops__aigen_3_1 - scallops__aigen_3
    potato__objaverse_13_1 - potato__objaverse_13
    orange__objaverse_10_1 - orange__objaverse_10
    apple__objaverse_22_1 - apple__objaverse_22
    egg__objaverse_9_1 - egg__objaverse_9
