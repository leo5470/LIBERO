    (On potato__objaverse_13_1 floor_other_object_region_0)
    (On orange__objaverse_10_1 floor_other_object_region_1)
    (On apple__objaverse_22_1 floor_other_object_region_2)
    (On egg__objaverse_9_1 floor_other_object_region_3)
    (On sponge__objaverse_5_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
