  (:obj_of_interest
    sponge__aigen_9_1
    basket_1
  )

  (:init
    (On sponge__aigen_9_1 floor_target_object_region)
    (On coffee_cup__aigen_4_1 floor_other_object_region_0)
    (On water_bottle__objaverse_0_1 floor_other_object_region_1)
    (On wine_glass__aigen_1_1 floor_other_object_region_2)
    (On pitcher__aigen_3_1 floor_other_object_region_3)
    (On donut__aigen_6_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
