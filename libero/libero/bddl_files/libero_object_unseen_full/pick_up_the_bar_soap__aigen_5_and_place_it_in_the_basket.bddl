    (On condiment_bottle__objaverse_condiment_2_1 floor_other_object_region_0)
    (On bar__objaverse_9_1 floor_other_object_region_1)
    (On rolling_pin__objaverse_4_1 floor_other_object_region_2)
    (On tangerine__objaverse_4_1 floor_other_object_region_3)
    (On jug__objaverse_4_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
