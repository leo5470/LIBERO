  )

  (:init
    (On bread_flat__aigen_bread_11_1 floor_target_object_region)
    (On mug__objaverse_14_1 floor_other_object_region_0)
    (On lobster__aigen_1_1 floor_other_object_region_1)
    (On grapes__aigen_6_1 floor_other_object_region_2)
    (On thermos__aigen_7_1 floor_other_object_region_3)
    (On soap_dispenser__aigen_5_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
