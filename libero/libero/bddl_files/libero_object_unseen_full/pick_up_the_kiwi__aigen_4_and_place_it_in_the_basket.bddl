(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the kiwi and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    kiwi__aigen_4_1 - kiwi__aigen_4
    mushroom__objaverse_6_1 - mushroom__objaverse_6
    pomegranate__aigen_1_1 - pomegranate__aigen_1
    eggplant__aigen_2_1 - eggplant__aigen_2
    tangerine__aigen_0_1 - tangerine__aigen_0
    strawberry__aigen_6_1 - strawberry__aigen_6
    basket_1 - basket
  )

  (:obj_of_interest
    kiwi__aigen_4_1
    basket_1
  )

  (:init
    (On kiwi__aigen_4_1 floor_target_object_region)
    (On mushroom__objaverse_6_1 floor_other_object_region_0)
    (On pomegranate__aigen_1_1 floor_other_object_region_1)
    (On eggplant__aigen_2_1 floor_other_object_region_2)
    (On tangerine__aigen_0_1 floor_other_object_region_3)
    (On strawberry__aigen_6_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In kiwi__aigen_4_1 basket_1_contain_region))
  )

)
