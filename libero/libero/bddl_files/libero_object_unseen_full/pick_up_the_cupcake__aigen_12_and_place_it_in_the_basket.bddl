    (On corn__aigen_2_1 floor_other_object_region_0)
    (On beet__aigen_6_1 floor_other_object_region_1)
    (On asparagus__aigen_5_1 floor_other_object_region_2)
    (On can__aigen_3_1 floor_other_object_region_3)
    (On jug__objaverse_5_1 floor_other_object_region_4)
