(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the candle and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    candle__aigen_5_1 - candle__aigen_5
    liquor__objaverse_alcohol_11_1 - liquor__objaverse_alcohol_11
    cup__aigen_17_1 - cup__aigen_17
    orange__objaverse_11_1 - orange__objaverse_11
    celery__aigen_3_1 - celery__aigen_3
    scallops__aigen_2_1 - scallops__aigen_2
    basket_1 - basket
  )

  (:obj_of_interest
    candle__aigen_5_1
    basket_1
  )

  (:init
    (On candle__aigen_5_1 floor_target_object_region)
    (On liquor__objaverse_alcohol_11_1 floor_other_object_region_0)
    (On cup__aigen_17_1 floor_other_object_region_1)
    (On orange__objaverse_11_1 floor_other_object_region_2)
    (On celery__aigen_3_1 floor_other_object_region_3)
    (On scallops__aigen_2_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In candle__aigen_5_1 basket_1_contain_region))
  )

)
