    (On croissant__objaverse_5_1 floor_other_object_region_0)
    (On condiment_bottle__objaverse_condiment_0_1 floor_other_object_region_1)
    (On cereal__aigen_6_1 floor_other_object_region_2)
    (On pot__aigen_0_1 floor_other_object_region_3)
    (On liquor__objaverse_alcohol_7_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
