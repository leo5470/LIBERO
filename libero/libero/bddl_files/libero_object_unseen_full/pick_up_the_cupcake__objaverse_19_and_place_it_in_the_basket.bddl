          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    cupcake__objaverse_19_1 - cupcake__objaverse_19
    croissant__objaverse_5_1 - croissant__objaverse_5
    condiment_bottle__objaverse_condiment_0_1 - condiment_bottle__objaverse_condiment_0
