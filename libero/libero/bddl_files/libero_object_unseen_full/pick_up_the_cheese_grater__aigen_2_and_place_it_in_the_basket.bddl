          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    cheese_grater__aigen_2_1 - cheese_grater__aigen_2
    tomato__objaverse_8_1 - tomato__objaverse_8
    celery__aigen_5_1 - celery__aigen_5
    corn__aigen_0_1 - corn__aigen_0
