    (On tomato__objaverse_8_1 floor_other_object_region_0)
    (On celery__aigen_5_1 floor_other_object_region_1)
    (On corn__aigen_0_1 floor_other_object_region_2)
    (On pitcher__aigen_12_1 floor_other_object_region_3)
    (On carrot__aigen_7_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
