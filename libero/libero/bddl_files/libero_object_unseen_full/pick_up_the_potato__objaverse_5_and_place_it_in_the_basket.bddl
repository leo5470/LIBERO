    (On liquor__objaverse_alcohol_4_1 floor_other_object_region_0)
    (On onion__objaverse_3_1 floor_other_object_region_1)
    (On garlic__objaverse_2_1 floor_other_object_region_2)
    (On boxed_drink__aigen_12_1 floor_other_object_region_3)
    (On cupcake__objaverse_6_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
