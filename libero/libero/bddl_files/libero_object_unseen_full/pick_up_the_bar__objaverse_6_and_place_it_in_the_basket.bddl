    (On teapot__objaverse_14_1 floor_other_object_region_0)
    (On grapes__aigen_6_1 floor_other_object_region_1)
    (On eggplant__objaverse_4_1 floor_other_object_region_2)
    (On jam__aigen_1_1 floor_other_object_region_3)
    (On sushi__aigen_12_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
