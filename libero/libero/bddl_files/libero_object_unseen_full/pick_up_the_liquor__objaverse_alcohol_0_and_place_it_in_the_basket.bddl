  )

  (:init
    (On liquor__objaverse_alcohol_0_1 floor_target_object_region)
    (On tongs__aigen_5_1 floor_other_object_region_0)
    (On celery__aigen_8_1 floor_other_object_region_1)
    (On shrimp__aigen_0_1 floor_other_object_region_2)
    (On mango__objaverse_12_1 floor_other_object_region_3)
    (On tomato__aigen_4_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
