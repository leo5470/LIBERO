    basket_1
  )

  (:init
    (On banana__objaverse_12_1 floor_target_object_region)
    (On wine_glass__aigen_3_1 floor_other_object_region_0)
    (On baguette__aigen_17_1 floor_other_object_region_1)
    (On tongs__aigen_1_1 floor_other_object_region_2)
    (On ketchup__objaverse_8_1 floor_other_object_region_3)
    (On milk__objaverse_4_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
