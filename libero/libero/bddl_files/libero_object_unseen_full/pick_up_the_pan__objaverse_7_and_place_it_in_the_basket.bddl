(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the pan and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    pan__objaverse_7_1 - pan__objaverse_7
    cereal__objaverse_2_1 - cereal__objaverse_2
    strawberry__aigen_9_1 - strawberry__aigen_9
    honey_bottle__aigen_6_1 - honey_bottle__aigen_6
    pomegranate__aigen_1_1 - pomegranate__aigen_1
    cheese_grater__aigen_1_1 - cheese_grater__aigen_1
    basket_1 - basket
  )

  (:obj_of_interest
    pan__objaverse_7_1
    basket_1
  )

  (:init
    (On pan__objaverse_7_1 floor_target_object_region)
    (On cereal__objaverse_2_1 floor_other_object_region_0)
    (On strawberry__aigen_9_1 floor_other_object_region_1)
    (On honey_bottle__aigen_6_1 floor_other_object_region_2)
    (On pomegranate__aigen_1_1 floor_other_object_region_3)
    (On cheese_grater__aigen_1_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In pan__objaverse_7_1 basket_1_contain_region))
  )

)
