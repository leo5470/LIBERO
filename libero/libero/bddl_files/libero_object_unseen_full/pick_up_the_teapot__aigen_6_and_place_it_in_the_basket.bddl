    (On kebabs__aigen_5_1 floor_other_object_region_0)
    (On condiment_bottle__objaverse_condiment_3_1 floor_other_object_region_1)
    (On orange__objaverse_8_1 floor_other_object_region_2)
    (On lobster__aigen_4_1 floor_other_object_region_3)
    (On broccoli__objaverse_1_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
