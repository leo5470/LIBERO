    (On squash__objaverse_1_1 floor_other_object_region_0)
    (On jello_cup__aigen_1_1 floor_other_object_region_1)
    (On bottled_water__objaverse_2_1 floor_other_object_region_2)
    (On saucepan__objaverse_pan_22_1 floor_other_object_region_3)
    (On honey_bottle__aigen_1_1 floor_other_object_region_4)
