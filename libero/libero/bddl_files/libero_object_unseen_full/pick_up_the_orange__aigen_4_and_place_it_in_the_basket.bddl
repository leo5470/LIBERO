  (:objects
    orange__aigen_4_1 - orange__aigen_4
    celery__aigen_3_1 - celery__aigen_3
    cucumber__aigen_4_1 - cucumber__aigen_4
    banana__objaverse_7_1 - banana__objaverse_7
