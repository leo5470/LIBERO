    (On celery__aigen_3_1 floor_other_object_region_0)
    (On cucumber__aigen_4_1 floor_other_object_region_1)
    (On banana__objaverse_7_1 floor_other_object_region_2)
    (On milk__objaverse_5_1 floor_other_object_region_3)
    (On beet__aigen_9_1 floor_other_object_region_4)
