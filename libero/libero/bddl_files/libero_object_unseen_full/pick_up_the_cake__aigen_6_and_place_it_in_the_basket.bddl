    (On bottled_drink__aigen_12_1 floor_other_object_region_0)
    (On mango__objaverse_18_1 floor_other_object_region_1)
    (On milk__objaverse_10_1 floor_other_object_region_2)
    (On bell_pepper__objaverse_3_1 floor_other_object_region_3)
    (On shrimp__aigen_7_1 floor_other_object_region_4)
