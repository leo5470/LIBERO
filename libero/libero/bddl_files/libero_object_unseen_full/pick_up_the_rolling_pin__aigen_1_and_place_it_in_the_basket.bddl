(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the rolling pin and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    rolling_pin__aigen_1_1 - rolling_pin__aigen_1
    jug__objaverse_2_1 - jug__objaverse_2
    liquor__objaverse_alcohol_10_1 - liquor__objaverse_alcohol_10
    grapes__aigen_12_1 - grapes__aigen_12
    bell_pepper__objaverse_0_1 - bell_pepper__objaverse_0
    candy__aigen_6_1 - candy__aigen_6
    basket_1 - basket
  )

  (:obj_of_interest
    rolling_pin__aigen_1_1
    basket_1
  )

  (:init
    (On rolling_pin__aigen_1_1 floor_target_object_region)
    (On jug__objaverse_2_1 floor_other_object_region_0)
    (On liquor__objaverse_alcohol_10_1 floor_other_object_region_1)
    (On grapes__aigen_12_1 floor_other_object_region_2)
    (On bell_pepper__objaverse_0_1 floor_other_object_region_3)
    (On candy__aigen_6_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In rolling_pin__aigen_1_1 basket_1_contain_region))
  )

)
