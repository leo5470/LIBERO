    (On honey_bottle__aigen_0_1 floor_other_object_region_0)
    (On pitcher__aigen_6_1 floor_other_object_region_1)
    (On onion__objaverse_8_1 floor_other_object_region_2)
    (On chili_pepper__aigen_3_1 floor_other_object_region_3)
    (On sponge__aigen_3_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
