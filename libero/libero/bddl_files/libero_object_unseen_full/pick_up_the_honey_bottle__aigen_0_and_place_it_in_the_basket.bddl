    basket_1
  )

  (:init
    (On honey_bottle__aigen_0_1 floor_target_object_region)
    (On milk__aigen_6_1 floor_other_object_region_0)
    (On soap_dispenser__objaverse_2_1 floor_other_object_region_1)
    (On garlic__objaverse_5_1 floor_other_object_region_2)
    (On lamb_chop__aigen_5_1 floor_other_object_region_3)
    (On ginger__aigen_2_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
