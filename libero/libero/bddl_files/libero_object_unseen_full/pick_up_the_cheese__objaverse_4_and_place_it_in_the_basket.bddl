    basket_1
  )

  (:init
    (On cheese__objaverse_4_1 floor_target_object_region)
    (On sweet_potato__aigen_10_1 floor_other_object_region_0)
    (On egg__aigen_10_1 floor_other_object_region_1)
    (On ice_cream__aigen_8_1 floor_other_object_region_2)
    (On grapes__aigen_0_1 floor_other_object_region_3)
    (On jam__aigen_17_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In cheese__objaverse_4_1 basket_1_contain_region))
  )

)
