    (On beet__aigen_9_1 floor_other_object_region_0)
    (On jam__aigen_9_1 floor_other_object_region_1)
    (On egg__aigen_9_1 floor_other_object_region_2)
    (On tangerine__objaverse_3_1 floor_other_object_region_3)
    (On lime__objaverse_2_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
