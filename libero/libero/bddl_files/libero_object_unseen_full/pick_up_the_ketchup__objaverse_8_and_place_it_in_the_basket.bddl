    basket_1
  )

  (:init
    (On ketchup__objaverse_8_1 floor_target_object_region)
    (On lemonade__aigen_1_1 floor_other_object_region_0)
    (On onion__objaverse_9_1 floor_other_object_region_1)
    (On bell_pepper__objaverse_3_1 floor_other_object_region_2)
    (On avocado__objaverse_5_1 floor_other_object_region_3)
    (On kettle_non_electric__objaverse_kettle_22_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
