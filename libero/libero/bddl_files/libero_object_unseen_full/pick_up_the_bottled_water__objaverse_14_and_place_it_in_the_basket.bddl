    (On hot_dog__aigen_9_1 floor_other_object_region_0)
    (On pot__aigen_0_1 floor_other_object_region_1)
    (On wine__objaverse_12_1 floor_other_object_region_2)
    (On kiwi__aigen_7_1 floor_other_object_region_3)
    (On canola_oil__aigen_5_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
