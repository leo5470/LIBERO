  (:fixtures
    floor - floor
  )

  (:objects
    bottled_water__objaverse_14_1 - bottled_water__objaverse_14
    hot_dog__aigen_9_1 - hot_dog__aigen_9
    pot__aigen_0_1 - pot__aigen_0
