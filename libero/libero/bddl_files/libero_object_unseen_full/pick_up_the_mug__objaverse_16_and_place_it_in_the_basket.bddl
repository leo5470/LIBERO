    (On mushroom__aigen_7_1 floor_other_object_region_0)
    (On saucepan__objaverse_pan_0_1 floor_other_object_region_1)
    (On tongs__aigen_4_1 floor_other_object_region_2)
    (On squash__objaverse_15_1 floor_other_object_region_3)
    (On steak__aigen_5_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
