    (On fish__objaverse_7_1 floor_other_object_region_0)
    (On canned_food__objaverse_0_1 floor_other_object_region_1)
    (On burrito__aigen_8_1 floor_other_object_region_2)
    (On pear__aigen_12_1 floor_other_object_region_3)
    (On water_bottle__objaverse_15_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
