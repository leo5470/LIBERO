    (On sweet_potato__aigen_10_1 floor_other_object_region_0)
    (On boxed_food__objaverse_0_1 floor_other_object_region_1)
    (On cheese_grater__aigen_6_1 floor_other_object_region_2)
    (On cake__aigen_2_1 floor_other_object_region_3)
    (On scallops__aigen_15_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
