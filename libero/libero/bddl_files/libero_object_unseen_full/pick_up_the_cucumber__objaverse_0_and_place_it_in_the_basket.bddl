  )

  (:init
    (On cucumber__objaverse_0_1 floor_target_object_region)
    (On baguette__objaverse_1_1 floor_other_object_region_0)
    (On cupcake__aigen_6_1 floor_other_object_region_1)
    (On apple__objaverse_13_1 floor_other_object_region_2)
    (On bottled_water__objaverse_2_1 floor_other_object_region_3)
    (On pomegranate__aigen_0_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
