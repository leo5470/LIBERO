    basket_1
  )

  (:init
    (On avocado__aigen_8_1 floor_target_object_region)
    (On jug_wide_opening__objaverse_jug_3_1 floor_other_object_region_0)
    (On peanut_butter__aigen_jar_7_1 floor_other_object_region_1)
    (On orange__objaverse_13_1 floor_other_object_region_2)
    (On wine__aigen_5_1 floor_other_object_region_3)
    (On donut__objaverse_5_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
