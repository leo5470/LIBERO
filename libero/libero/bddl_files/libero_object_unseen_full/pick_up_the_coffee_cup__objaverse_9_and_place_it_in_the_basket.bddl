    (On pickle__aigen_0_1 floor_other_object_region_0)
    (On chili_pepper__aigen_4_1 floor_other_object_region_1)
    (On bell_pepper__objaverse_0_1 floor_other_object_region_2)
    (On mug__objaverse_18_1 floor_other_object_region_3)
    (On brussel_sprout__aigen_2_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
