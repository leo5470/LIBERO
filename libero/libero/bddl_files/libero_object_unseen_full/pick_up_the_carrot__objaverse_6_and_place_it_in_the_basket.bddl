    (On kebabs__aigen_4_1 floor_other_object_region_0)
    (On tongs__aigen_5_1 floor_other_object_region_1)
    (On egg__objaverse_0_1 floor_other_object_region_2)
    (On rolling_pin__aigen_3_1 floor_other_object_region_3)
    (On mushroom__aigen_1_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
