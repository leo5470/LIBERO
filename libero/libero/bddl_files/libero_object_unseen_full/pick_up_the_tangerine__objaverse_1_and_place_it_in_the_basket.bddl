(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the tangerine and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    tangerine__objaverse_1_1 - tangerine__objaverse_1
    cheese__aigen_5_1 - cheese__aigen_5
    liquor__objaverse_alcohol_2_1 - liquor__objaverse_alcohol_2
    apricot__aigen_5_1 - apricot__aigen_5
    coffee_cup__objaverse_17_1 - coffee_cup__objaverse_17
    celery__aigen_0_1 - celery__aigen_0
    basket_1 - basket
  )

  (:obj_of_interest
    tangerine__objaverse_1_1
    basket_1
  )

  (:init
    (On tangerine__objaverse_1_1 floor_target_object_region)
    (On cheese__aigen_5_1 floor_other_object_region_0)
    (On liquor__objaverse_alcohol_2_1 floor_other_object_region_1)
    (On apricot__aigen_5_1 floor_other_object_region_2)
    (On coffee_cup__objaverse_17_1 floor_other_object_region_3)
    (On celery__aigen_0_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In tangerine__objaverse_1_1 basket_1_contain_region))
  )

)
