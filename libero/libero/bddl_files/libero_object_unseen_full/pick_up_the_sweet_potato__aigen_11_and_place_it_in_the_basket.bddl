    (On sushi__aigen_8_1 floor_other_object_region_0)
    (On mango__aigen_6_1 floor_other_object_region_1)
    (On cup__aigen_13_1 floor_other_object_region_2)
    (On baguette__aigen_8_1 floor_other_object_region_3)
    (On bottled_water__objaverse_2_1 floor_other_object_region_4)
