    basket_1
  )

  (:init
    (On banana__objaverse_6_1 floor_target_object_region)
    (On canola_oil__aigen_8_1 floor_other_object_region_0)
    (On teapot__aigen_0_1 floor_other_object_region_1)
    (On canned_food__aigen_6_1 floor_other_object_region_2)
    (On mug__objaverse_17_1 floor_other_object_region_3)
    (On grapes__aigen_4_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
