          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    kettle_non_electric__aigen_kettle_8_1 - kettle_non_electric__aigen_kettle_8
    croissant__objaverse_5_1 - croissant__objaverse_5
    strawberry__aigen_0_1 - strawberry__aigen_0
    ginger__aigen_6_1 - ginger__aigen_6
