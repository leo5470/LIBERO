    (On croissant__objaverse_5_1 floor_other_object_region_0)
    (On strawberry__aigen_0_1 floor_other_object_region_1)
    (On ginger__aigen_6_1 floor_other_object_region_2)
    (On bottled_drink__objaverse_0_1 floor_other_object_region_3)
    (On pitcher__aigen_10_1 floor_other_object_region_4)
