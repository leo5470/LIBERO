(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the boxed drink and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    boxed_drink__aigen_2_1 - boxed_drink__aigen_2
    apple__objaverse_3_1 - apple__objaverse_3
    donut__aigen_0_1 - donut__aigen_0
    milk__objaverse_10_1 - milk__objaverse_10
    sponge__aigen_2_1 - sponge__aigen_2
    coffee_cup__objaverse_16_1 - coffee_cup__objaverse_16
    basket_1 - basket
  )

  (:obj_of_interest
    boxed_drink__aigen_2_1
    basket_1
  )

  (:init
    (On boxed_drink__aigen_2_1 floor_target_object_region)
    (On apple__objaverse_3_1 floor_other_object_region_0)
    (On donut__aigen_0_1 floor_other_object_region_1)
    (On milk__objaverse_10_1 floor_other_object_region_2)
    (On sponge__aigen_2_1 floor_other_object_region_3)
    (On coffee_cup__objaverse_16_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In boxed_drink__aigen_2_1 basket_1_contain_region))
  )

)
