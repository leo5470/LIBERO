  )

  (:obj_of_interest
    bottled_water__aigen_7_1
    basket_1
  )

  (:init
    (On bottled_water__aigen_7_1 floor_target_object_region)
    (On bell_pepper__objaverse_2_1 floor_other_object_region_0)
    (On boxed_food__aigen_4_1 floor_other_object_region_1)
    (On cake__objaverse_7_1 floor_other_object_region_2)
    (On ginger__aigen_2_1 floor_other_object_region_3)
    (On can__objaverse_18_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
