    (On candle__aigen_2_1 floor_other_object_region_0)
    (On tangerine__aigen_10_1 floor_other_object_region_1)
    (On cheese__objaverse_6_1 floor_other_object_region_2)
    (On croissant__aigen_3_1 floor_other_object_region_3)
    (On sponge__aigen_2_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
