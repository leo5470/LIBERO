(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the candle  aigen 9 and place it in the rc tray)
    (:regions
      (candle__aigen_9_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.025 -0.125 0.025 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (rc_tray_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 0.12 0.03 0.18)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target rc_tray_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    candle__aigen_9_1 - candle__aigen_9
    rc_tray_1 - rc_tray
  )

  (:obj_of_interest
    candle__aigen_9_1
    rc_tray_1
  )

  (:init
    (On candle__aigen_9_1 kitchen_table_candle__aigen_9_init_region)
    (On rc_tray_1 kitchen_table_rc_tray_init_region)
  )

  (:goal
    (And (In candle__aigen_9_1 rc_tray_1_contain_region))
  )

)
