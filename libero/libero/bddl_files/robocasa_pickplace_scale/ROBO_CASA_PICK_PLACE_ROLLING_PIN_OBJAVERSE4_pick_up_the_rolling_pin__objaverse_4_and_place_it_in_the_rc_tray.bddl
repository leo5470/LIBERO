(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the rolling pin  objaverse 4 and place it in the rc tray)
    (:regions
      (rolling_pin__objaverse_4_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.025 -0.125 0.025 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (rc_tray_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 0.12 0.03 0.18)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target rc_tray_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    rolling_pin__objaverse_4_1 - rolling_pin__objaverse_4
    rc_tray_1 - rc_tray
  )

  (:obj_of_interest
    rolling_pin__objaverse_4_1
    rc_tray_1
  )

  (:init
    (On rolling_pin__objaverse_4_1 kitchen_table_rolling_pin__objaverse_4_init_region)
    (On rc_tray_1 kitchen_table_rc_tray_init_region)
  )

  (:goal
    (And (In rolling_pin__objaverse_4_1 rc_tray_1_contain_region))
  )

)
