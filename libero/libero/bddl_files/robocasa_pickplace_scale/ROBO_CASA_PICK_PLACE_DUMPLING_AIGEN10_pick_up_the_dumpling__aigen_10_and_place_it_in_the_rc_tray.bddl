(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the dumpling  aigen 10 and place it in the rc tray)
    (:regions
      (dumpling__aigen_10_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.025 -0.125 0.025 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (rc_tray_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 0.12 0.03 0.18)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target rc_tray_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    dumpling__aigen_10_1 - dumpling__aigen_10
    rc_tray_1 - rc_tray
  )

  (:obj_of_interest
    dumpling__aigen_10_1
    rc_tray_1
  )

  (:init
    (On dumpling__aigen_10_1 kitchen_table_dumpling__aigen_10_init_region)
    (On rc_tray_1 kitchen_table_rc_tray_init_region)
  )

  (:goal
    (And (In dumpling__aigen_10_1 rc_tray_1_contain_region))
  )

)
